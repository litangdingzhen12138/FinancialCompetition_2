TEXT2SQL_LLM_URL=https://api.deepseek.com/chat/completions
# If the provider only gives a base URL, omit TEXT2SQL_LLM_URL and use:
# TEXT2SQL_LLM_BASE_URL=https://api.example.com/v1
TEXT2SQL_LLM_API_KEY=your-deepseek-api-key
TEXT2SQL_LLM_MODEL=deepseek-v4-flash
TEXT2SQL_LLM_PROVIDER=openai_compatible
TEXT2SQL_LLM_TIMEOUT=20
TEXT2SQL_LLM_RETRIES=1
TEXT2SQL_PRODUCT_DB_PATH=data/product.sqlite3
TEXT2SQL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TEXT2SQL_ALLOW_HEADER_AUTH=false
# The following accounts/passwords are local-demo defaults. Replace all of them
# before any networked deployment; use the bank SSO adapter in production.
TEXT2SQL_ANALYST_USERNAME=analyst
TEXT2SQL_ANALYST_PASSWORD=analyst123
TEXT2SQL_ANALYST_NAME=总行管理层
TEXT2SQL_ANALYST_2_USERNAME=analyst2
TEXT2SQL_ANALYST_2_PASSWORD=analyst2123
TEXT2SQL_ANALYST_2_NAME=分支行管理层
TEXT2SQL_ANALYST_2_ORGS=ORG001
TEXT2SQL_ANALYST_3_USERNAME=analyst3
TEXT2SQL_ANALYST_3_PASSWORD=analyst3123
TEXT2SQL_ANALYST_3_NAME=业务条线人员
TEXT2SQL_ANALYST_3_ORGS=ORG001
TEXT2SQL_RISK_USERNAME=risk
TEXT2SQL_RISK_PASSWORD=risk123
TEXT2SQL_RISK_NAME=风险合规人员
TEXT2SQL_FINANCE_USERNAME=finance
TEXT2SQL_FINANCE_PASSWORD=finance123
TEXT2SQL_FINANCE_NAME=财务人员
TEXT2SQL_ADMIN_USERNAME=admin
TEXT2SQL_ADMIN_PASSWORD=admin123
TEXT2SQL_ADMIN_NAME=系统管理员
TEXT2SQL_AUTH_TOKEN_HOURS=12

# Optional path overrides
# TEXT2SQL_XLSX_PATH=D:\path\dataset.xlsx
# TEXT2SQL_DB_PATH=D:\path\bank_metrics.duckdb
