# 主域名与 www 域名都解析到服务器，并同时交给 Caddy 申请 HTTPS 证书。
PUBLIC_HOST="bankinsight.example.com, www.bankinsight.example.com"
# 前后端经同一个 Caddy 入口访问时保持为空，避免把镜像绑定到固定域名。
PUBLIC_BASE_URL=
HTTP_PORT=80
HTTPS_PORT=443

# 依赖源网络不可达时可替换，不需要时保持默认：
# PYPI_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org

# 仅使用 compose.tls.yaml 加载自有证书时需要取消注释并修改：
# TLS_CERT_DIR=./certs
# TLS_CERT_FILE=/certs/tls.crt
# TLS_KEY_FILE=/certs/tls.key

TEXT2SQL_LLM_URL=https://api.deepseek.com/chat/completions
TEXT2SQL_LLM_API_KEY=replace-with-real-key
TEXT2SQL_LLM_MODEL=deepseek-v4-flash
TEXT2SQL_LLM_TIMEOUT=20
TEXT2SQL_LLM_RETRIES=1

TEXT2SQL_XLSX_PATH=/app/source/dataset.xlsx
TEXT2SQL_DB_PATH=/app/data/bank_metrics.duckdb
TEXT2SQL_PRODUCT_DB_PATH=/app/data/product.sqlite3
TEXT2SQL_CORS_ORIGINS=https://bankinsight.example.com,https://www.bankinsight.example.com
TEXT2SQL_ALLOW_HEADER_AUTH=false

TEXT2SQL_ANALYST_USERNAME=analyst
TEXT2SQL_ANALYST_PASSWORD=replace-with-strong-password
TEXT2SQL_ANALYST_NAME=总行管理层
TEXT2SQL_ANALYST_2_USERNAME=analyst2
TEXT2SQL_ANALYST_2_PASSWORD=replace-with-strong-password
TEXT2SQL_ANALYST_2_NAME=分支行管理层
TEXT2SQL_ANALYST_2_ORGS=ORG001
TEXT2SQL_ANALYST_3_USERNAME=analyst3
TEXT2SQL_ANALYST_3_PASSWORD=replace-with-strong-password
TEXT2SQL_ANALYST_3_NAME=业务条线人员
TEXT2SQL_ANALYST_3_ORGS=ORG001
TEXT2SQL_RISK_USERNAME=risk
TEXT2SQL_RISK_PASSWORD=replace-with-strong-password
TEXT2SQL_RISK_NAME=风险合规人员
TEXT2SQL_FINANCE_USERNAME=finance
TEXT2SQL_FINANCE_PASSWORD=replace-with-strong-password
TEXT2SQL_FINANCE_NAME=财务人员
TEXT2SQL_ADMIN_USERNAME=bankadmin
TEXT2SQL_ADMIN_PASSWORD=replace-with-strong-password
TEXT2SQL_ADMIN_NAME=系统管理员
TEXT2SQL_AUTH_TOKEN_HOURS=12
